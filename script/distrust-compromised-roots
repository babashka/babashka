#!/usr/bin/env bash

# Removes the roots behind the eMudhra intermediate CA compromise (October
# 2026, https://we-have-a-problem.com) from GraalVM's trust store.
#
# native-image builds the trust store of $GRAALVM_HOME into the binary, and
# GraalVM releases up to 25.0.4 still trust "AAA Certificate Services" and
# "emSign ECC Root CA - G3". Neither bb nor the JVM checks revocation or
# Certificate Transparency, so without this anyone holding the leaked keys
# could impersonate any host to bb. Remove once GraalVM drops them.

set -euo pipefail

if [ -z "${GRAALVM_HOME:-}" ]; then
    echo "Please set GRAALVM_HOME"
    exit 1
fi

# SHA-256 fingerprints of "AAA Certificate Services" (Comodo) and
# "emSign ECC Root CA - G3"
fingerprints=(
    "D7:A7:A0:FB:5D:7E:27:31:D7:71:E9:48:4E:BC:DE:F7:1D:5F:0C:3E:0A:29:48:78:2B:C8:3E:E0:EA:69:9E:F4"
    "86:A1:EC:BA:08:9C:4A:8D:3B:BE:27:34:C6:12:BA:34:1D:81:3E:04:3C:F9:E8:A8:62:CD:5C:57:A3:6B:BE:6B"
)

keytool="$GRAALVM_HOME/bin/keytool"
cacerts="$GRAALVM_HOME/lib/security/cacerts"

for fingerprint in "${fingerprints[@]}"; do
    aliases=$("$keytool" -list -v -cacerts -storepass changeit |
        awk -v fp="$fingerprint" '/^Alias name: / {alias = substr($0, 13)}
                                  $1 == "SHA256:" && $2 == fp {print alias}')
    while IFS= read -r alias; do
        [ -n "$alias" ] || continue
        "$keytool" -delete -alias "$alias" -cacerts -storepass changeit
        echo "Removed $alias from $cacerts"
    done <<< "$aliases"
done
