;; Entries either name a deps.edn snapshot under deps/ or carry :deps
;; inline. Versions are pinned, the resolution should not drift.
[{:name "babashka" :deps-file "deps/babashka.edn"}
 {:name "clj-kondo" :deps-file "deps/clj-kondo.edn"}
 {:name "quickblog" :deps-file "deps/quickblog.edn"}
 {:name "clojure-lsp" :deps-file "deps/clojure-lsp.edn"}
 {:name "medley" :deps {medley/medley {:mvn/version "1.3.0"}}}
 {:name "core-async" :deps {org.clojure/core.async {:mvn/version "1.8.741"}}}
 {:name "ring" :deps {ring/ring {:mvn/version "1.12.2"}}}
 {:name "reitit" :deps {metosin/reitit {:mvn/version "0.7.2"}}}
 ;; Java: parent chains, dependencyManagement, properties
 {:name "guava" :deps {com.google.guava/guava {:mvn/version "33.3.1-jre"}}}
 {:name "jackson" :deps {com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.17.2"}}}
 {:name "netty" :deps {io.netty/netty-handler {:mvn/version "4.1.115.Final"}}}
 {:name "log4j" :deps {org.apache.logging.log4j/log4j-core {:mvn/version "2.24.1"}}}
 ;; BOM imports
 {:name "junit" :deps {org.junit.jupiter/junit-jupiter {:mvn/version "5.11.2"}}}
 {:name "spring-boot" :deps {org.springframework.boot/spring-boot-starter {:mvn/version "3.3.4"}}}
 {:name "aws-s3" :deps {software.amazon.awssdk/s3 {:mvn/version "2.28.0"}}}
 ;; relocation
 {:name "xml-apis" :deps {xml-apis/xml-apis {:mvn/version "2.0.2"}}}
 ;; git dep next to mvn deps
 {:name "integrant-git" :deps {integrant/integrant {:git/url "https://github.com/weavejester/integrant"
                                                   :git/sha "a9fd7c02bd7201f36344b47142badc3c3ef22f88"}}}
 ;; metadata: a -SNAPSHOT coordinate and a version range
 {:name "snapshot" :deps {clj-kondo/clj-kondo {:mvn/version "2025.10.24-SNAPSHOT"}}}
 {:name "range" :deps {org.clojure/data.json {:mvn/version "[2.4,2.5)"}}}
 ;; git dep with a pom.xml manifest, contrib parent from the repositories
 {:name "tools-cli-git" :deps {org.clojure/tools.cli {:git/url "https://github.com/clojure/tools.cli"
                                                       :git/sha "717e187ec98e6a75c7f26a3120fbe9eecc434f05"}}}]
