#!/usr/bin/env bash

# Builds a pinned static libffi. babashka.ffi calls struct-by-value
# functions through it, and script/compile links the archive this prints.
#
# 3.4.6 does not build with current Apple clang, so the version is pinned
# like zlib and musl.
#
# The archive must match the architecture native-image TARGETS, which is
# not always the one this machine runs. Oracle publishes no macOS x64
# GraalVM after 25.0.1, so the mac release build uses that one under
# Rosetta on an arm64 runner: native-image emits x86_64 while cc here
# defaults to arm64, and the linker then ignores the archive and reports
# ffi_call as undefined. So the target comes from the GraalVM in
# GRAALVM_HOME, and an archive built for another one is rebuilt.
#
# Prints the path of the archive.

set -euo pipefail

LIBFFI_VERSION="3.5.1"
LIBFFI_SHA256="f99eb68a67c7d54866b7706af245e87ba060d419a062474b456d3bc8d4abdbd1"

# The architecture native-image targets: the one its own binaries are
# built for, not the one this machine runs.
target_arch() {
    local java="${GRAALVM_HOME:-}/bin/java"
    if [ -x "$java" ]; then
        "$java" -XshowSettings:properties -version 2>&1 |
            sed -n 's/.*os\.arch = //p' | head -1
    else
        uname -m
    fi
}

arch="$(target_arch)"
case "$arch" in
    x86_64|amd64) arch="x86_64" ;;
    aarch64|arm64) arch="arm64" ;;
esac

# not under target, which lein clean empties between the two build steps.
# Per architecture, so a machine that builds for two of them keeps both.
prefix="${LIBFFI_PREFIX:-$PWD/.libffi/$arch}"

# libffi installs into lib or lib64, depending on the platform
find_archive() {
    { find "$prefix" -name libffi.a -not -path "$prefix/build/*" 2> /dev/null || true; } | head -1
}

archive="$(find_archive)"

if [ -n "$archive" ]; then
    echo "$archive"
    exit 0
fi

# the sha256sum on macOS is a different tool that takes no checksum file
if sha256sum --version > /dev/null 2>&1; then
    sha256() { sha256sum "$1" | cut -d' ' -f1; }
else
    sha256() { shasum -a 256 "$1" | cut -d' ' -f1; }
fi

build="$prefix/build"
mkdir -p "$build"
cd "$build"

tarball="libffi-${LIBFFI_VERSION}.tar.gz"
url="https://github.com/libffi/libffi/releases/download/v${LIBFFI_VERSION}/${tarball}"

curl -O -sL --fail --show-error "$url"

actual="$(sha256 "$tarball")"

if [ "$actual" != "$LIBFFI_SHA256" ]; then
    echo "setup-libffi: $tarball is $actual, expected $LIBFFI_SHA256" >&2
    exit 1
fi

tar xf "$tarball"

cd "libffi-${LIBFFI_VERSION}"
configure_args=(--disable-shared --enable-static --disable-docs --prefix="$prefix")

if [ "$(uname -s)" = "Darwin" ] && [ "$arch" != "$(uname -m)" ]; then
    # cross build, which on macOS means -arch plus a host triple that
    # configure accepts for the target
    export CFLAGS="${CFLAGS:-} -arch $arch"
    export LDFLAGS="${LDFLAGS:-} -arch $arch"
    configure_args+=("--host=${arch}-apple-darwin")
fi

./configure "${configure_args[@]}" > /dev/null
make > /dev/null
make install > /dev/null

archive="$(find_archive)"

if [ -z "$archive" ]; then
    echo "setup-libffi: no libffi.a under $prefix" >&2
    exit 1
fi

echo "$archive"
