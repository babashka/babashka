#!/usr/bin/env bash

set -eo pipefail

: "${BABASHKA_TEST_ENV:=jvm}"
export BABASHKA_TEST_ENV

if [ "$BABASHKA_TEST_ENV" = "native" ]; then
    BB_CMD="$(pwd)/bb"
else
    BB_CMD="clojure -M:babashka/dev"
fi

export PATH
# The process tests put a program in the working directory and expect a bare
# name not to find it. A developer with this checkout on PATH, to run the
# dev build as bb, would find it, so the checkout is dropped from PATH.
PATH=$(echo "$PATH" | tr ':' '\n' | grep -vx "$(pwd)" | grep -vx "$(pwd)/" | paste -sd: -)
PATH=$(pwd)/process/target/test/on-path:$PATH

export BABASHKA_CLASSPATH
BABASHKA_CLASSPATH=$(clojure -Spath -A:lib-tests)

$BB_CMD -cp "$BABASHKA_CLASSPATH" \
        -f "test-resources/lib_tests/babashka/run_all_libtests.clj" "$@"
